# =====================================================================
# Circle of Life — variáveis para rodar no seu computador (pnpm dev)
#
# Copie este arquivo para ".env" (na mesma pasta) antes do primeiro
# "pnpm dev". Os valores abaixo já funcionam localmente; não é preciso
# mudar nada. Em produção, os mesmos nomes são configurados no painel
# de cada serviço (veja apps/api/.env.example e apps/web/.env.example).
# =====================================================================

# Ambiente. "development" liga o login de teste e outras ajudas locais.
NODE_ENV=development

# ---------- Site (Next.js) ----------
# Porta e endereço público do site.
WEB_PORT=3000
WEB_URL=http://localhost:3000

# ---------- API (Nest.js) ----------
# Porta da API e o endereço que o site usa para repassar /api/* para ela.
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000

# ---------- Banco de dados (PostgreSQL) ----------
# Endereço completo do banco. No "pnpm dev", o Postgres local é criado
# com o usuário, a senha, a porta e o nome de banco que estão aqui.
DATABASE_URL=postgresql://circle:circle@localhost:5432/circle_of_life

# ---------- Storage de arquivos (compatível com S3) ----------
# Endereço que a API usa para falar com o storage.
S3_ENDPOINT=http://localhost:8333
# Endereço que o NAVEGADOR usa (vai dentro das URLs pré-assinadas).
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=circle-of-life
# Chaves de acesso do storage. Localmente podem ser quaisquer valores.
S3_ACCESS_KEY_ID=circle-local
S3_SECRET_ACCESS_KEY=circle-local-secret
# "true" para storages que usam endereço no formato servidor/bucket (local).
S3_FORCE_PATH_STYLE=true
# "true" faz a API criar o bucket e liberar o envio pelo site ao iniciar.
# Em produção, deixe "false" (o bucket é criado no painel do provedor).
S3_CREATE_BUCKET=true
# Sites autorizados a enviar arquivos direto para o storage (separe por vírgula).
S3_CORS_ORIGINS=http://localhost:3000

# ---------- E-mail (SMTP) ----------
# Localmente, os e-mails vão para o Mailpit: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Circle of Life <nao-responda@circleoflife.local>"
# Porta da tela do Mailpit (usada só pelo pnpm dev).
MAILPIT_UI_PORT=8025

# ---------- Login e sessão ----------
# Segredo que assina o cookie de login. Localmente qualquer texto longo serve;
# em produção use um valor aleatório e secreto (pelo menos 32 caracteres).
JWT_SECRET=troque-este-segredo-local-por-um-texto-bem-longo-123
# Quantos dias a pessoa fica logada sem precisar entrar de novo.
SESSION_DAYS=30
# Domínio do cookie. Deixe vazio localmente.
COOKIE_DOMAIN=
# "invite" = só entra quem foi convidado por um administrador.
SIGNUP_MODE=invite
# Validade dos convites, em dias.
INVITE_DAYS=7
# Login com Google. Sem estes dois valores o botão do Google fica desativado
# e você entra pelo login de teste. Para criar: console.cloud.google.com >
# APIs e serviços > Credenciais > ID do cliente OAuth (aplicativo da Web),
# com o endereço de retorno http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ---------- Notificações ----------
# Notificações no celular (Web Push). Sem estas chaves, as notificações
# aparecem só no sino do app. Para gerar: pnpm push:keys
# (o envio ao celular passa pelo serviço de push do navegador, que é externo)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nao-responda@circleoflife.local
# Hora (no fuso da pessoa) a partir da qual sai o aviso de tarefas atrasadas.
OVERDUE_HOUR=8

# ---------- Análise inteligente (IA) ----------
# mock = relatório de exemplo montado com os seus dados, sem chamar nenhum serviço externo.
# anthropic = usa a API do Claude (precisa da chave abaixo).
AI_MODE=mock
# Chave da API do Claude (https://console.anthropic.com). Só com AI_MODE=anthropic.
ANTHROPIC_API_KEY=
# Modelo do Claude usado na análise.
AI_MODEL=claude-opus-5-5
# Intervalo mínimo, em minutos, entre dois relatórios da mesma pessoa.
AI_MIN_MINUTES=5
