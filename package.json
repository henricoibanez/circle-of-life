{
  "name": "circle-of-life",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:local": "tsx scripts/setup-local.ts",
    "dev": "tsx scripts/dev.ts",
    "db:studio": "pnpm --filter @circle/api db:studio",
    "db:seed": "pnpm --filter @circle/api db:seed",
    "db:reset": "pnpm --filter @circle/api db:reset",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @circle/api test",
    "stop": "tsx scripts/stop.ts",
    "push:keys": "pnpm --filter @circle/api exec web-push generate-vapid-keys"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "dotenv": "18.0.6",
    "embedded-postgres": "17.10.0-beta.17",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
