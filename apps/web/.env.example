# =====================================================================
# Site (Next.js) — variáveis de ambiente
#
# Localmente, o "pnpm dev" usa o arquivo .env da raiz do projeto.
# Esta lista é a referência para configurar o site em outros ambientes
# (por exemplo, na Vercel).
# =====================================================================

# Endereço da API. O site repassa todo pedido para /api/* a este endereço,
# assim o navegador só conversa com o próprio site.
API_INTERNAL_URL=https://api.exemplo.com.br

# Porta do site (usada só fora da Vercel).
WEB_PORT=3000

# Só no servidor ANTIGO, quando o app muda de endereço: toda página redireciona para
# o mesmo caminho neste endereço (ex.: https://circleoflife.labzz.studio). Vazio = normal.
# É lida na montagem do site: depois de mudar, publique de novo.
MOVED_TO_URL=
