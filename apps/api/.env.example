# =====================================================================
# API (Nest.js) — variáveis de ambiente
#
# Localmente, o "pnpm dev" usa o arquivo .env da raiz do projeto.
# Esta lista é a referência para configurar a API em outros ambientes
# (por exemplo, no host de contêiner da produção).
# =====================================================================

# "production" em produção. Só "development" liga o login de teste.
NODE_ENV=production

# Porta em que a API escuta.
API_PORT=4000

# Endereço público do site (usado em links de e-mail e redirecionamentos).
WEB_URL=https://app.exemplo.com.br

# Banco de dados PostgreSQL (na produção: Supabase).
DATABASE_URL=postgresql://usuario:senha@servidor:5432/banco

# Storage compatível com S3 (na produção: Storage do Supabase via S3).
S3_ENDPOINT=https://exemplo.storage.supabase.co/storage/v1/s3
S3_PUBLIC_ENDPOINT=https://exemplo.storage.supabase.co/storage/v1/s3
S3_REGION=sa-east-1
S3_BUCKET=circle-of-life
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Em produção o bucket e o CORS são configurados no painel do provedor.
S3_CREATE_BUCKET=false
S3_CORS_ORIGINS=https://app.exemplo.com.br

# Servidor de e-mail (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Circle of Life <nao-responda@exemplo.com.br>"

# Segredo do cookie de login: valor aleatório, secreto, com 32+ caracteres.
JWT_SECRET=
SESSION_DAYS=30
# Se o site e a API ficarem em subdomínios (ex.: app. e api.), use o domínio comum.
COOKIE_DOMAIN=
# "invite": só convidados entram. "open": qualquer conta Google.
SIGNUP_MODE=invite
# E-mails (separados por vírgula) que entram com o Google sem convite e viram
# administradores. Use para o primeiro acesso em produção.
ADMIN_EMAILS=
INVITE_DAYS=7
# Credenciais OAuth do Google (endereço de retorno: {WEB_URL}/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ---------- Notificações ----------
# Notificações no celular (Web Push). Sem estas chaves, as notificações
# aparecem só no sino do app. Para gerar: pnpm push:keys
# (o envio ao celular passa pelo serviço de push do navegador, que é externo)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nao-responda@circleoflife.local
# Hora (no fuso da pessoa) a partir da qual sai o aviso de tarefas atrasadas.
OVERDUE_HOUR=8

# ---------- Análise inteligente (IA) ----------
# mock = relatório de exemplo montado com os seus dados, sem chamar nenhum serviço externo.
# anthropic = usa a API do Claude (precisa da chave abaixo).
AI_MODE=mock
# Chave da API do Claude (https://console.anthropic.com). Só com AI_MODE=anthropic.
ANTHROPIC_API_KEY=
# Modelo do Claude usado na análise.
AI_MODEL=claude-opus-5-5
# Intervalo mínimo, em minutos, entre dois relatórios da mesma pessoa.
AI_MIN_MINUTES=5
