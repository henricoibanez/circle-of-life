// Modelo de dados do Circle of Life.
// A referência completa (todas as tabelas previstas) está em docs/plano.md.
// Mudanças aqui só valem depois de uma migration: pnpm --filter @circle/api db:migrate

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  member
  admin
}

/// Paleta de cores escolhida no perfil (as 6 do protótipo).
enum Palette {
  natureza
  serenity
  soft
  dourado
  mindful
  premium
}

/// Aparência: seguir o sistema, clara ou escura.
enum ThemeMode {
  auto
  light
  dark
}

/// Quem vê posts e stories: "Todo mundo", "Somente amigos" ou "Privado".
enum Visibility {
  publico
  amigos
  privado
}

// ---------- Usuários e convites ----------

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  googleId              String?    @unique
  role                  UserRole   @default(member)
  name                  String
  /// Aparece no perfil como "ID: @handle".
  handle                String     @unique
  bio                   String     @default("")
  /// Foto do perfil (ligada à tabela de arquivos na etapa 7).
  photoFileId           String?    @unique
  palette               Palette    @default(natureza)
  randomTheme           Boolean    @default(false)
  themeMode             ThemeMode  @default(auto)
  defaultPostVisibility Visibility @default(publico)
  timezone              String     @default("America/Sao_Paulo")
  /// Tudo que a pessoa já ganhou de XP (cópia rápida da soma do extrato, etapa 6).
  xpTotal               Int        @default(0)
  /// XP gasto comprando trilhas. XP disponível = xpTotal - xpSpent.
  xpSpent               Int        @default(0)
  /// Usuários criados pelo seed para o login de desenvolvimento.
  isTestUser            Boolean    @default(false)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  invitesSent            Invite[]            @relation("InvitedBy")
  invitesAccepted        Invite[]            @relation("AcceptedBy")
  initiatives            Initiative[]
  epics                  Epic[]
  tasks                  Task[]
  sprints                Sprint[]
  xpEvents               XpEvent[]
  activity               ActivityEvent[]
  files                  File[]
  rodaScores             RodaScore[]
  rodaSnapshots          RodaSnapshot[]
  maslowChecks           MaslowCheck[]
  maslowNotes            MaslowNote[]
  necrologio             Necrologio?
  dreams                 Dream[]
  notifications          Notification[]      @relation("NotificationsReceived")
  notified               Notification[]      @relation("NotificationsCaused")
  pushSubscriptions      PushSubscription[]
  trilhas                Trilha[]            @relation("TrilhasAuthored")
  trilhaFavorites        TrilhaFavorite[]
  trilhaAcquisitions     TrilhaAcquisition[]
  friendRequestsSent     Friendship[]        @relation("FriendRequestsSent")
  friendRequestsReceived Friendship[]        @relation("FriendRequestsReceived")
  groupMemberships       GroupMember[]
  posts                  Post[]
  postLikes              PostLike[]
  postSaves              PostSave[]
  comments               Comment[]
  stories                Story[]
  storyLikes             StoryLike[]
  storyViews             StoryView[]
  analysisReports        AnalysisReport[]
  groupTopics            GroupTopic[]
  groupReplies           GroupReply[]

  @@map("users")
}

/// Convite de acesso (só administradores convidam). O link enviado por
/// e-mail leva o token; aqui guardamos apenas o "resumo" (hash) dele,
/// para que um vazamento do banco não exponha convites válidos.
model Invite {
  id             String    @id @default(cuid())
  email          String
  tokenHash      String    @unique
  invitedById    String
  invitedBy      User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  acceptedUser   User?     @relation("AcceptedBy", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([email])
  @@map("invites")
}

// ---------- Backlog: Iniciativa > Épico > Tarefa ----------

enum Area {
  lazer
  amor
  financas
  familia
  intelectual
  espiritualidade
  sociedade
  saude
  emocional
  profissional
}

/// Backlog → A Fazer → Fazendo → Pronto. O quadro mostra só os três últimos.
enum TaskStatus {
  backlog
  todo
  doing
  done
}

enum Priority {
  alta
  media
  baixa
}

/// De onde veio a iniciativa.
enum InitiativeSource {
  manual
  trilha
  ia
  duplicada
}

/// Objetivo estratégico de alto nível (ex.: "Vida longa e próspera").
model Initiative {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String           @default("")
  areas       Area[]
  /// "Objetivo Master".
  isMaster    Boolean          @default(false)
  source      InitiativeSource @default(manual)
  /// Trilha de origem (loja ou grupo), quando importada.
  trilhaId    String?
  /// Concluída (todos os épicos encerrados) = conquista.
  completedAt DateTime?
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  epics       Epic[]

  @@index([userId])
  @@map("initiatives")
}

/// Conjunto de entregas relacionadas, dentro de uma iniciativa. Tem uma área da vida.
model Epic {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  title        String
  description  String     @default("")
  area         Area
  /// Encerrado (todas as tarefas prontas) = conquista.
  closedAt     DateTime?
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tasks        Task[]

  @@index([userId])
  @@index([initiativeId])
  @@map("epics")
}

/// Ação específica e executável, dentro de um épico. A área é a do épico.
model Task {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  epicId            String
  epic              Epic             @relation(fields: [epicId], references: [id], onDelete: Cascade)
  title             String
  description       String           @default("")
  status            TaskStatus       @default(backlog)
  priority          Priority         @default(media)
  /// "Previsão de entrega" (só a data).
  dueDate           DateTime?        @db.Date
  doneAt            DateTime?
  /// Saiu do quadro ao encerrar a sprint (vai para os relatórios).
  archivedAt        DateTime?
  /// Sprint em que a tarefa entrou no quadro / foi entregue.
  sprintId          String?
  sprint            Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  /// Quando o aviso de "tarefa atrasada" já foi enviado.
  overdueNotifiedAt DateTime?
  /// Ordem dentro da coluna do quadro.
  position          Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  checklist         ChecklistItem[]
  logs              TaskLog[]
  attachments       TaskAttachment[]

  @@index([userId, status])
  @@index([epicId])
  @@map("tasks")
}

model ChecklistItem {
  id       String  @id @default(cuid())
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text     String
  done     Boolean @default(false)
  position Int     @default(0)

  @@index([taskId])
  @@map("checklist_items")
}

/// Histórico da tarefa ("Movida de A Fazer para Fazendo").
model TaskLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_logs")
}

/// Sprint de 14 dias. Sempre existe uma em andamento (closedAt vazio) por usuário.
model Sprint {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  number     Int
  startAt    DateTime
  /// startAt + 13 dias (14 dias no total).
  plannedEnd DateTime
  closedAt   DateTime?
  /// Preenchidos ao encerrar: "prontas/total".
  doneCount  Int?
  totalCount Int?
  tasks      Task[]

  @@unique([userId, number])
  @@map("sprints")
}

// ---------- XP e atividade ----------

/// Motivo de cada lançamento no extrato de XP (regras provisórias em packages/shared/src/xp.ts).
enum XpReason {
  task
  check
  epic
  iniciativa
  sprint
  roda
  sonho
  post
  story
  comentario
  trilha_download
  trilha_compra
}

/// Extrato de XP: cada ganho (+), estorno (-) e gasto. O total fica copiado em User.xpTotal / xpSpent.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    XpReason
  /// O que gerou o lançamento (tarefa, épico, sprint, dia do post…).
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, reason, refId])
  @@map("xp_events")
}

/// "Atividade recente" do perfil.
model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  icon      String
  text      String
  /// Tela para onde o item leva (ex.: /board).
  link      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("activity_events")
}

// ---------- Arquivos (storage S3) ----------

/// Para que o arquivo serve (define o limite de tamanho e a pasta no storage).
enum FilePurpose {
  avatar
  dream
  task
  post
  story
  group
  trilha
}

enum FileStatus {
  /// URL de envio criada, mas o navegador ainda não confirmou o envio.
  pending
  ready
}

/// Arquivo guardado no storage. O banco guarda só a referência (key); o arquivo vai direto do navegador para o storage.
model File {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Caminho no bucket: users/{userId}/{purpose}/{id}.{ext}
  key        String          @unique
  /// Nome original (ex.: foto.jpg).
  name       String
  mime       String
  size       Int
  purpose    FilePurpose
  status     FileStatus      @default(pending)
  createdAt  DateTime        @default(now())
  attachment TaskAttachment?
  postMedia  PostMedia?
  story      Story?

  @@index([userId, status])
  @@map("files")
}

/// Imagem anexada a uma tarefa.
model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileId    String   @unique
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_attachments")
}

// ---------- Exercícios de reflexão ----------

/// Nota atual (0 a 10) de cada área da Roda da Vida.
model RodaScore {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  area      Area
  score     Int
  updatedAt DateTime @updatedAt

  @@id([userId, area])
  @@map("roda_scores")
}

/// "Registrar avaliação de hoje": foto das 10 notas num dia (a evolução aparece nos relatórios).
model RodaSnapshot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// { "lazer": 6, "amor": 7, … }
  scores    Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("roda_snapshots")
}

/// Item da Pirâmide de Maslow marcado como atendido. Os itens em si ficam em packages/shared/src/maslow.ts.
model MaslowCheck {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ex.: "fis-0" (nível + posição do item).
  itemKey   String
  checkedAt DateTime @default(now())

  @@id([userId, itemKey])
  @@map("maslow_checks")
}

/// Reflexão escrita em um nível da pirâmide.
model MaslowNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// aut, est, soc, seg ou fis.
  level     String
  text      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("maslow_notes")
}

/// Necrológio: o texto (HTML já limpo pelo servidor). Sem seções nesta versão.
model Necrologio {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  html      String   @default("")
  updatedAt DateTime @updatedAt

  @@map("necrologios")
}

/// Sonho do Quadro de visualização (até 10 abertos). "Realizei" marca doneAt.
model Dream {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  area        Area
  imageFileId String?   @unique
  doneAt      DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("dreams")
}

// ---------- Notificações ----------

enum NotificationType {
  amizade_pedido
  amizade_aceita
  curtida
  curtida_story
  comentario
  tarefa_atrasada
  trilha_baixada
  trilha_aprovada
  trilha_recusada
  trilha_pendente
  grupo_entrada
  grupo_trilha
  grupo_topico
  grupo_resposta
  grupo_trilha_sugerida
  grupo_gestor
}

/// Notificação do sino (e, se ativado, também enviada ao celular).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String           @default("")
  /// Tela para onde a notificação leva.
  link      String
  /// Quem causou (curtiu, comentou…), se houver.
  actorId   String?
  actor     User?            @relation("NotificationsCaused", fields: [actorId], references: [id], onDelete: Cascade)
  /// O que gerou (tarefa, post…), para agrupar e evitar repetidas.
  refId     String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Aparelho que aceitou receber notificações no celular (Web Push).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// ---------- Loja de trilhas ----------

/// Toda publicação passa por "pendente" até ser aprovada ou recusada: na loja, por um administrador
/// do app; num grupo, por um gestor do grupo (o que o gestor publica já entra aprovado).
enum TrilhaStatus {
  pendente
  aprovada
  recusada
  despublicada
}

/// Trilha: cópia congelada de um épico (com as tarefas) para importar no backlog.
/// Sem grupo = loja (qualquer pessoa baixa); com grupo = só os membros do grupo veem e baixam.
model Trilha {
  id              String              @id @default(cuid())
  /// Id da primeira versão. Versões novas da mesma trilha compartilham o rootId.
  rootId          String
  /// Versão aprovada que esta substitui quando for aprovada.
  replacesId      String?
  /// Nulo = trilha oficial do Circle of Life. No grupo: quem criou ou sugeriu.
  authorId        String?
  author          User?               @relation("TrilhasAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  /// Grupo dono da trilha (nulo = loja).
  groupId         String?
  group           Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Épico de onde a trilha foi publicada.
  sourceEpicId    String?
  /// Trilha da loja de onde esta cópia do grupo veio.
  copiedFromId    String?
  title           String
  description     String
  category        String
  area            Area
  /// Capa: imagem enviada, ou ilustração (art + cor) com texto opcional.
  /// Não é única: a cópia do grupo usa a mesma capa da trilha da loja.
  coverFileId     String?
  art             String              @default("lake")
  color           String              @default("#5e873c")
  coverText       String?
  /// 0 = grátis. Trilhas de grupo são sempre grátis.
  priceXp         Int                 @default(0)
  status          TrilhaStatus        @default(pendente)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  /// Número de downloads mostrado antes dos downloads reais (trilhas oficiais do seed).
  baseDownloads   Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tasks           TrilhaTask[]
  favorites       TrilhaFavorite[]
  acquisitions    TrilhaAcquisition[]

  @@index([status])
  @@index([rootId])
  @@index([groupId])
  @@map("trilhas")
}

model TrilhaTask {
  id       String @id @default(cuid())
  trilhaId String
  trilha   Trilha @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  title    String
  position Int

  @@map("trilha_tasks")
}

model TrilhaFavorite {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trilhaId String
  trilha   Trilha @relation(fields: [trilhaId], references: [id], onDelete: Cascade)

  @@id([userId, trilhaId])
  @@map("trilha_favorites")
}

/// Quem já adquiriu (baixou ou comprou) a trilha. Dá direito a importar de novo sem pagar.
model TrilhaAcquisition {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trilhaId  String
  trilha    Trilha   @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  rootId    String
  xpPaid    Int      @default(0)
  createdAt DateTime @default(now())

  @@id([userId, trilhaId])
  @@index([rootId])
  @@map("trilha_acquisitions")
}

// ---------- Amigos e grupos ----------

enum FriendshipStatus {
  pending
  accepted
}

/// Amizade: pedido de requester para addressee; vira "accepted" quando aceito.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

/// admin = Gestor do grupo (aprova trilhas, modera o fórum). O criador escolhe os gestores.
enum GroupRole {
  admin
  member
}

/// Grupo criado por um usuário: pessoas interessadas num assunto e trilhas prontas.
model Group {
  id          String        @id @default(cuid())
  name        String
  description String
  area        Area
  icon        String        @default("users")
  art         String        @default("lake")
  coverFileId String?       @unique
  createdById String?
  createdAt   DateTime      @default(now())
  members     GroupMember[]
  trilhas     Trilha[]
  posts       Post[]
  topics      GroupTopic[]

  @@map("groups")
}

model GroupMember {
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(member)
  joinedAt DateTime  @default(now())

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// ---------- Feed ----------

/// Post do feed. Quem vê: publico = todos; amigos = amigos do autor; privado = só o autor.
/// Post de grupo: só os membros do grupo.
model Post {
  id         String      @id @default(cuid())
  authorId   String
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Conquista (opcional), mostrada em destaque com o ✓.
  title      String      @default("")
  text       String
  area       Area?
  groupId    String?
  group      Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  visibility Visibility
  tags       String[]
  /// O que originou o post ao compartilhar uma conclusão (task, epic, initiative, sprint, sonho).
  refType    String?
  refId      String?
  /// "+N XP" mostrado no post, calculado pela API a partir do extrato de XP do que originou o post.
  xpShown    Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  media      PostMedia[]
  likes      PostLike[]
  saves      PostSave[]
  comments   Comment[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([groupId, createdAt])
  @@map("posts")
}

/// Imagens do post (até 8), na ordem escolhida.
model PostMedia {
  id       String @id @default(cuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  fileId   String @unique
  file     File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  position Int

  @@index([postId])
  @@map("post_media")
}

model PostLike {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@map("post_likes")
}

model PostSave {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@map("post_saves")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@map("comments")
}

// ---------- Stories ----------

/// Story: foto que some em 24 horas, com 1 a 3 áreas (os ícones viram marca d'água).
/// Quem vê segue a mesma regra dos posts fora de grupo.
model Story {
  id         String      @id @default(cuid())
  authorId   String
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  fileId     String      @unique
  file       File        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  areas      Area[]
  /// Legenda curta (até 150 caracteres).
  caption    String      @default("")
  visibility Visibility
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
  likes      StoryLike[]
  views      StoryView[]

  @@index([expiresAt])
  @@index([authorId, createdAt])
  @@map("stories")
}

model StoryLike {
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([storyId, userId])
  @@map("story_likes")
}

/// "Visto por": só o autor vê a lista.
model StoryView {
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@id([storyId, userId])
  @@map("story_views")
}

// ---------- Análise inteligente ----------

enum AiMode {
  mock
  anthropic
}

/// Relatório da análise inteligente: cruza os exercícios escolhidos com o backlog.
model AnalysisReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        AiMode
  /// Fontes que a pessoa escolheu (necrologio, roda, maslow, quadro, tarefas).
  sources     String[]
  geral       Int
  visao       String
  /// [{ area, pct, texto }]
  areas       Json
  /// [{ icon, titulo, texto }]
  insights    Json
  /// [{ iniciativa: { titulo, descricao, areas }, epicos: [{ titulo, area, tarefas: [titulo] }] }]
  suggestions Json
  /// Índices das sugestões já importadas para o backlog.
  imported    Int[]    @default([])
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("analysis_reports")
}

// ---------- Fórum dos grupos ----------

/// Tópico do fórum de um grupo. Só os membros leem e escrevem.
model GroupTopic {
  id             String       @id @default(cuid())
  groupId        String
  group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title          String
  text           String       @default("")
  /// Última resposta (ou a criação): a lista mostra primeiro os tópicos mais movimentados.
  lastActivityAt DateTime     @default(now())
  createdAt      DateTime     @default(now())
  replies        GroupReply[]

  @@index([groupId, lastActivityAt])
  @@map("group_topics")
}

model GroupReply {
  id        String     @id @default(cuid())
  topicId   String
  topic     GroupTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime   @default(now())

  @@index([topicId, createdAt])
  @@map("group_replies")
}
