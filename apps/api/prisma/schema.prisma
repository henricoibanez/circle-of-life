// Modelo de dados do Circle of Life.
// A referência completa (todas as tabelas previstas) está em docs/plano.md.
// Mudanças aqui só valem depois de uma migration: pnpm --filter @circle/api db:migrate

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  member
  admin
}

/// Paleta de cores escolhida no perfil (as 6 do protótipo).
enum Palette {
  natureza
  serenity
  soft
  dourado
  mindful
  premium
}

/// Aparência: seguir o sistema, clara ou escura.
enum ThemeMode {
  auto
  light
  dark
}

/// Quem vê posts e stories: "Todo mundo", "Somente amigos" ou "Privado".
enum Visibility {
  publico
  amigos
  privado
}

// ---------- Usuários e convites ----------

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  googleId              String?    @unique
  role                  UserRole   @default(member)
  name                  String
  /// Aparece no perfil como "ID: @handle".
  handle                String     @unique
  bio                   String     @default("")
  /// Foto do perfil (ligada à tabela de arquivos na etapa 7).
  photoFileId           String?    @unique
  palette               Palette    @default(natureza)
  randomTheme           Boolean    @default(false)
  themeMode             ThemeMode  @default(auto)
  defaultPostVisibility Visibility @default(publico)
  timezone              String     @default("America/Sao_Paulo")
  /// Tudo que a pessoa já ganhou de XP (cópia rápida da soma do extrato, etapa 6).
  xpTotal               Int        @default(0)
  /// XP gasto comprando trilhas. XP disponível = xpTotal - xpSpent.
  xpSpent               Int        @default(0)
  /// Usuários criados pelo seed para o login de desenvolvimento.
  isTestUser            Boolean    @default(false)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  invitesSent     Invite[] @relation("InvitedBy")
  invitesAccepted Invite[] @relation("AcceptedBy")
  initiatives     Initiative[]
  epics           Epic[]
  tasks           Task[]
  sprints         Sprint[]
  xpEvents        XpEvent[]
  activity        ActivityEvent[]
  files           File[]
  rodaScores      RodaScore[]
  rodaSnapshots   RodaSnapshot[]
  maslowChecks    MaslowCheck[]
  maslowNotes     MaslowNote[]
  necrologio      Necrologio?
  dreams          Dream[]

  @@map("users")
}

/// Convite de acesso (só administradores convidam). O link enviado por
/// e-mail leva o token; aqui guardamos apenas o "resumo" (hash) dele,
/// para que um vazamento do banco não exponha convites válidos.
model Invite {
  id             String    @id @default(cuid())
  email          String
  tokenHash      String    @unique
  invitedById    String
  invitedBy      User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  acceptedUser   User?     @relation("AcceptedBy", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([email])
  @@map("invites")
}

// ---------- Backlog: Iniciativa > Épico > Tarefa ----------

enum Area {
  lazer
  amor
  financas
  familia
  intelectual
  espiritualidade
  sociedade
  saude
  emocional
  profissional
}

/// Backlog → A Fazer → Fazendo → Pronto. O quadro mostra só os três últimos.
enum TaskStatus {
  backlog
  todo
  doing
  done
}

enum Priority {
  alta
  media
  baixa
}

/// De onde veio a iniciativa.
enum InitiativeSource {
  manual
  trilha
  ia
  duplicada
}

/// Objetivo estratégico de alto nível (ex.: "Vida longa e próspera").
model Initiative {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String           @default("")
  areas       Area[]
  /// "Objetivo Master".
  isMaster    Boolean          @default(false)
  source      InitiativeSource @default(manual)
  /// Trilha de origem (loja ou grupo), quando importada.
  trilhaId    String?
  /// Concluída (todos os épicos encerrados) = conquista.
  completedAt DateTime?
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  epics       Epic[]

  @@index([userId])
  @@map("initiatives")
}

/// Conjunto de entregas relacionadas, dentro de uma iniciativa. Tem uma área da vida.
model Epic {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  title        String
  description  String     @default("")
  area         Area
  /// Encerrado (todas as tarefas prontas) = conquista.
  closedAt     DateTime?
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tasks        Task[]

  @@index([userId])
  @@index([initiativeId])
  @@map("epics")
}

/// Ação específica e executável, dentro de um épico. A área é a do épico.
model Task {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  epicId            String
  epic              Epic            @relation(fields: [epicId], references: [id], onDelete: Cascade)
  title             String
  description       String          @default("")
  status            TaskStatus      @default(backlog)
  priority          Priority        @default(media)
  /// "Previsão de entrega" (só a data).
  dueDate           DateTime?       @db.Date
  doneAt            DateTime?
  /// Saiu do quadro ao encerrar a sprint (vai para os relatórios).
  archivedAt        DateTime?
  /// Sprint em que a tarefa entrou no quadro / foi entregue.
  sprintId          String?
  sprint            Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  /// Quando o aviso de "tarefa atrasada" já foi enviado.
  overdueNotifiedAt DateTime?
  /// Ordem dentro da coluna do quadro.
  position          Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  checklist         ChecklistItem[]
  logs              TaskLog[]
  attachments       TaskAttachment[]

  @@index([userId, status])
  @@index([epicId])
  @@map("tasks")
}

model ChecklistItem {
  id       String  @id @default(cuid())
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text     String
  done     Boolean @default(false)
  position Int     @default(0)

  @@index([taskId])
  @@map("checklist_items")
}

/// Histórico da tarefa ("Movida de A Fazer para Fazendo").
model TaskLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_logs")
}

/// Sprint de 14 dias. Sempre existe uma em andamento (closedAt vazio) por usuário.
model Sprint {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  number     Int
  startAt    DateTime
  /// startAt + 13 dias (14 dias no total).
  plannedEnd DateTime
  closedAt   DateTime?
  /// Preenchidos ao encerrar: "prontas/total".
  doneCount  Int?
  totalCount Int?
  tasks      Task[]

  @@unique([userId, number])
  @@map("sprints")
}

// ---------- XP e atividade ----------

/// Motivo de cada lançamento no extrato de XP (regras provisórias em packages/shared/src/xp.ts).
enum XpReason {
  task
  check
  epic
  iniciativa
  sprint
  roda
  sonho
  post
  story
  comentario
  trilha_download
  trilha_compra
}

/// Extrato de XP: cada ganho (+), estorno (-) e gasto. O total fica copiado em User.xpTotal / xpSpent.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    XpReason
  /// O que gerou o lançamento (tarefa, épico, sprint, dia do post…).
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, reason, refId])
  @@map("xp_events")
}

/// "Atividade recente" do perfil.
model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  icon      String
  text      String
  /// Tela para onde o item leva (ex.: /board).
  link      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("activity_events")
}

// ---------- Arquivos (storage S3) ----------

/// Para que o arquivo serve (define o limite de tamanho e a pasta no storage).
enum FilePurpose {
  avatar
  dream
  task
  post
  story
  group
  trilha
}

enum FileStatus {
  /// URL de envio criada, mas o navegador ainda não confirmou o envio.
  pending
  ready
}

/// Arquivo guardado no storage. O banco guarda só a referência (key); o arquivo vai direto do navegador para o storage.
model File {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Caminho no bucket: users/{userId}/{purpose}/{id}.{ext}
  key        String          @unique
  /// Nome original (ex.: foto.jpg).
  name       String
  mime       String
  size       Int
  purpose    FilePurpose
  status     FileStatus      @default(pending)
  createdAt  DateTime        @default(now())
  attachment TaskAttachment?

  @@index([userId, status])
  @@map("files")
}

/// Imagem anexada a uma tarefa.
model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileId    String   @unique
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_attachments")
}

// ---------- Exercícios de reflexão ----------

/// Nota atual (0 a 10) de cada área da Roda da Vida.
model RodaScore {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  area      Area
  score     Int
  updatedAt DateTime @updatedAt

  @@id([userId, area])
  @@map("roda_scores")
}

/// "Registrar avaliação de hoje": foto das 10 notas num dia (a evolução aparece nos relatórios).
model RodaSnapshot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// { "lazer": 6, "amor": 7, … }
  scores    Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("roda_snapshots")
}

/// Item da Pirâmide de Maslow marcado como atendido. Os itens em si ficam em packages/shared/src/maslow.ts.
model MaslowCheck {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ex.: "fis-0" (nível + posição do item).
  itemKey   String
  checkedAt DateTime @default(now())

  @@id([userId, itemKey])
  @@map("maslow_checks")
}

/// Reflexão escrita em um nível da pirâmide.
model MaslowNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// aut, est, soc, seg ou fis.
  level     String
  text      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("maslow_notes")
}

/// Necrológio: o texto (HTML já limpo pelo servidor). Sem seções nesta versão.
model Necrologio {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  html      String   @default("")
  updatedAt DateTime @updatedAt

  @@map("necrologios")
}

/// Sonho do Quadro de visualização (até 10 abertos). "Realizei" marca doneAt.
model Dream {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  area        Area
  imageFileId String?   @unique
  doneAt      DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("dreams")
}
