// Modelo de dados do Circle of Life.
// A referência completa (todas as tabelas previstas) está em docs/plano.md.
// Mudanças aqui só valem depois de uma migration: pnpm --filter @circle/api db:migrate

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  member
  admin
}

/// Paleta de cores escolhida no perfil (as 6 do protótipo).
enum Palette {
  natureza
  serenity
  soft
  dourado
  mindful
  premium
}

/// Aparência: seguir o sistema, clara ou escura.
enum ThemeMode {
  auto
  light
  dark
}

/// Quem vê posts e stories: "Todo mundo", "Somente amigos" ou "Privado".
enum Visibility {
  publico
  amigos
  privado
}

// ---------- Usuários e convites ----------

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  googleId              String?    @unique
  role                  UserRole   @default(member)
  name                  String
  /// Aparece no perfil como "ID: @handle".
  handle                String     @unique
  bio                   String     @default("")
  /// Foto do perfil (ligada à tabela de arquivos na etapa 7).
  photoFileId           String?    @unique
  palette               Palette    @default(natureza)
  randomTheme           Boolean    @default(false)
  themeMode             ThemeMode  @default(auto)
  defaultPostVisibility Visibility @default(publico)
  timezone              String     @default("America/Sao_Paulo")
  /// Tudo que a pessoa já ganhou de XP (cópia rápida da soma do extrato, etapa 6).
  xpTotal               Int        @default(0)
  /// XP gasto comprando trilhas. XP disponível = xpTotal - xpSpent.
  xpSpent               Int        @default(0)
  /// Usuários criados pelo seed para o login de desenvolvimento.
  isTestUser            Boolean    @default(false)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  invitesSent     Invite[] @relation("InvitedBy")
  invitesAccepted Invite[] @relation("AcceptedBy")
  initiatives     Initiative[]
  epics           Epic[]
  tasks           Task[]
  sprints         Sprint[]

  @@map("users")
}

/// Convite de acesso (só administradores convidam). O link enviado por
/// e-mail leva o token; aqui guardamos apenas o "resumo" (hash) dele,
/// para que um vazamento do banco não exponha convites válidos.
model Invite {
  id             String    @id @default(cuid())
  email          String
  tokenHash      String    @unique
  invitedById    String
  invitedBy      User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  acceptedUser   User?     @relation("AcceptedBy", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([email])
  @@map("invites")
}

// ---------- Backlog: Iniciativa > Épico > Tarefa ----------

enum Area {
  lazer
  amor
  financas
  familia
  intelectual
  espiritualidade
  sociedade
  saude
  emocional
  profissional
}

/// Backlog → A Fazer → Fazendo → Pronto. O quadro mostra só os três últimos.
enum TaskStatus {
  backlog
  todo
  doing
  done
}

enum Priority {
  alta
  media
  baixa
}

/// De onde veio a iniciativa.
enum InitiativeSource {
  manual
  trilha
  ia
  duplicada
}

/// Objetivo estratégico de alto nível (ex.: "Vida longa e próspera").
model Initiative {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String           @default("")
  areas       Area[]
  /// "Objetivo Master".
  isMaster    Boolean          @default(false)
  source      InitiativeSource @default(manual)
  /// Trilha de origem (loja ou grupo), quando importada.
  trilhaId    String?
  /// Concluída (todos os épicos encerrados) = conquista.
  completedAt DateTime?
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  epics       Epic[]

  @@index([userId])
  @@map("initiatives")
}

/// Conjunto de entregas relacionadas, dentro de uma iniciativa. Tem uma área da vida.
model Epic {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  title        String
  description  String     @default("")
  area         Area
  /// Encerrado (todas as tarefas prontas) = conquista.
  closedAt     DateTime?
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tasks        Task[]

  @@index([userId])
  @@index([initiativeId])
  @@map("epics")
}

/// Ação específica e executável, dentro de um épico. A área é a do épico.
model Task {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  epicId            String
  epic              Epic            @relation(fields: [epicId], references: [id], onDelete: Cascade)
  title             String
  description       String          @default("")
  status            TaskStatus      @default(backlog)
  priority          Priority        @default(media)
  /// "Previsão de entrega" (só a data).
  dueDate           DateTime?       @db.Date
  doneAt            DateTime?
  /// Saiu do quadro ao encerrar a sprint (vai para os relatórios).
  archivedAt        DateTime?
  /// Sprint em que a tarefa entrou no quadro / foi entregue.
  sprintId          String?
  sprint            Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  /// Quando o aviso de "tarefa atrasada" já foi enviado.
  overdueNotifiedAt DateTime?
  /// Ordem dentro da coluna do quadro.
  position          Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  checklist         ChecklistItem[]
  logs              TaskLog[]

  @@index([userId, status])
  @@index([epicId])
  @@map("tasks")
}

model ChecklistItem {
  id       String  @id @default(cuid())
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text     String
  done     Boolean @default(false)
  position Int     @default(0)

  @@index([taskId])
  @@map("checklist_items")
}

/// Histórico da tarefa ("Movida de A Fazer para Fazendo").
model TaskLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_logs")
}

/// Sprint de 14 dias. Sempre existe uma em andamento (closedAt vazio) por usuário.
model Sprint {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  number     Int
  startAt    DateTime
  /// startAt + 13 dias (14 dias no total).
  plannedEnd DateTime
  closedAt   DateTime?
  /// Preenchidos ao encerrar: "prontas/total".
  doneCount  Int?
  totalCount Int?
  tasks      Task[]

  @@unique([userId, number])
  @@map("sprints")
}
