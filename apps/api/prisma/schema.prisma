// Modelo de dados do Circle of Life.
// A referência completa (todas as tabelas previstas) está em docs/plano.md.
// Mudanças aqui só valem depois de uma migration: pnpm --filter @circle/api db:migrate

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  member
  admin
}

/// Paleta de cores escolhida no perfil (as 6 do protótipo).
enum Palette {
  natureza
  serenity
  soft
  dourado
  mindful
  premium
}

/// Aparência: seguir o sistema, clara ou escura.
enum ThemeMode {
  auto
  light
  dark
}

/// Quem vê posts e stories: "Todo mundo", "Somente amigos" ou "Privado".
enum Visibility {
  publico
  amigos
  privado
}

// ---------- Usuários e convites ----------

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  googleId              String?    @unique
  /// Token para criar eventos na Google Agenda da pessoa (quando ela conecta nas Configurações). Null = não conectada.
  googleCalendarToken   String?
  /// Quando a pessoa respondeu "Agora não" à sugestão de conectar a Google Agenda (volta depois de CALENDAR_ASK_AGAIN_DAYS dias).
  calendarAskedAt       DateTime?
  /// Resumo (scrypt) da senha, para quem entra com e-mail e senha. Nunca a senha em si.
  passwordHash          String?
  /// Quando aceitou os termos de uso (no cadastro com senha).
  termsAcceptedAt       DateTime?
  role                  UserRole   @default(member)
  name                  String
  /// Aparece no perfil como "ID: @handle".
  handle                String     @unique
  bio                   String     @default("")
  /// Foto do perfil (ligada à tabela de arquivos na etapa 7).
  photoFileId           String?    @unique
  palette               Palette    @default(natureza)
  randomTheme           Boolean    @default(false)
  themeMode             ThemeMode  @default(auto)
  defaultPostVisibility Visibility @default(publico)
  /// Passa pela Jornada de primeiro acesso (Minha vida trava o quadro). Quem já usava o app fica com false (tudo liberado).
  journey               Boolean    @default(false)
  /// Quando viu as boas-vindas da Jornada.
  journeyWelcomedAt     DateTime?
  /// Quando completou Minha vida (os 4 exercícios). Depois disso o quadro não tranca mais.
  minhaVidaAt           DateTime?
  /// Quantas fases da Jornada já tiveram o pop-up de parabéns mostrado.
  journeyPhaseSeen      Int        @default(0)
  /// Quando apertou "Concluir minha jornada" (ganha os 1.000 XP; conta os 7 dias para liberar de graça).
  journeyFinishedAt     DateTime?
  /// Quando a Jornada foi concluída de vez e a rede social abriu (pagando 500 XP, ou de graça depois dos 7 dias).
  socialUnlockedAt      DateTime?
  /// Quando viu o troféu "Jornada concluída" (com a apresentação da rede social).
  journeyCelebratedAt   DateTime?
  timezone              String     @default("America/Sao_Paulo")
  /// Tudo que a pessoa já ganhou de XP (cópia rápida da soma do extrato). XP não se gasta.
  xpTotal               Int        @default(0)
  /// Saldo de gemas, a moeda do app (cópia rápida da soma do extrato GemEvent; decisão do dono de 06/11/2026).
  gems                  Int        @default(0)
  /// Usuários criados pelo seed para o login de desenvolvimento.
  isTestUser            Boolean    @default(false)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  invitesSent            Invite[]            @relation("InvitedBy")
  invitesAccepted        Invite[]            @relation("AcceptedBy")
  initiatives            Initiative[]
  epics                  Epic[]
  tasks                  Task[]
  sprints                Sprint[]
  xpEvents               XpEvent[]
  gemEvents              GemEvent[]
  loginDays              UserLoginDay[]
  commentReactions       CommentReaction[]
  activity               ActivityEvent[]
  files                  File[]
  rodaScores             RodaScore[]
  rodaSnapshots          RodaSnapshot[]
  maslowChecks           MaslowCheck[]
  maslowNotes            MaslowNote[]
  necrologio             Necrologio?
  dreams                 Dream[]
  notifications          Notification[]      @relation("NotificationsReceived")
  notified               Notification[]      @relation("NotificationsCaused")
  pushSubscriptions      PushSubscription[]
  notificationPrefs      NotificationPrefs?
  notificationLog        NotificationLog[]
  releasesCreated        Release[]           @relation("ReleasesCreated")
  surveysCreated         Survey[]            @relation("SurveysCreated")
  surveyResponses        SurveyResponse[]
  trilhas                Trilha[]            @relation("TrilhasAuthored")
  trilhaFavorites        TrilhaFavorite[]
  trilhaAcquisitions     TrilhaAcquisition[]
  friendRequestsSent     Friendship[]        @relation("FriendRequestsSent")
  friendRequestsReceived Friendship[]        @relation("FriendRequestsReceived")
  blocksMade             Block[]             @relation("BlocksMade")
  blocksGot              Block[]             @relation("BlocksGot")
  groupMemberships       GroupMember[]
  groupBans              GroupBan[]
  groupRequests          GroupRequest[]
  posts                  Post[]
  postLikes              PostLike[]
  postSaves              PostSave[]
  comments               Comment[]
  stories                Story[]
  storyLikes             StoryLike[]
  storyViews             StoryView[]
  analysisReports        AnalysisReport[]
  groupTopics            GroupTopic[]
  groupReplies           GroupReply[]

  @@map("users")
}

/// Convite de acesso (só administradores convidam). O link enviado por
/// e-mail leva o token; aqui guardamos apenas o "resumo" (hash) dele,
/// para que um vazamento do banco não exponha convites válidos.
model Invite {
  id             String    @id @default(cuid())
  email          String
  tokenHash      String    @unique
  invitedById    String
  invitedBy      User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  acceptedUser   User?     @relation("AcceptedBy", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([email])
  @@map("invites")
}

// ---------- Backlog: Iniciativa > Épico > Tarefa ----------

enum Area {
  lazer
  amor
  financas
  familia
  intelectual
  espiritualidade
  sociedade
  saude
  emocional
  profissional
}

/// Backlog → A Fazer → Fazendo → Pronto. O quadro mostra só os três últimos.
enum TaskStatus {
  backlog
  todo
  doing
  done
}

enum Priority {
  alta
  media
  baixa
}

/// De onde veio a iniciativa.
enum InitiativeSource {
  manual
  trilha
  ia
  duplicada
}

/// Objetivo estratégico de alto nível (ex.: "Vida longa e próspera").
model Initiative {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String           @default("")
  areas       Area[]
  /// "Objetivo Master".
  isMaster    Boolean          @default(false)
  source      InitiativeSource @default(manual)
  /// Trilha de origem (loja ou grupo), quando importada.
  trilhaId    String?
  /// Concluída (todos os épicos encerrados) = conquista.
  completedAt DateTime?
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  epics       Epic[]

  @@index([userId])
  @@map("initiatives")
}

/// Conjunto de entregas relacionadas, dentro de uma iniciativa.
/// Tem várias áreas da vida (sem limite); "area" é a principal (a primeira).
model Epic {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  title        String
  description  String     @default("")
  /// Área principal (cor, ícone, categoria). É sempre a primeira de "areas".
  area         Area
  /// Todas as áreas do épico. Por padrão, as da iniciativa; a pessoa pode trocar.
  areas        Area[]     @default([])
  /// Encerrado (todas as tarefas prontas) = conquista.
  closedAt     DateTime?
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tasks        Task[]

  @@index([userId])
  @@index([initiativeId])
  @@map("epics")
}

/// Ação específica e executável, dentro de um épico.
/// Áreas próprias (até 3): a pessoa escolhe; vazio = usa a área do épico.
model Task {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  epicId            String
  epic              Epic             @relation(fields: [epicId], references: [id], onDelete: Cascade)
  title             String
  description       String           @default("")
  /// Até 3 áreas da vida. Vazio = herda a área do épico.
  areas             Area[]           @default([])
  status            TaskStatus       @default(backlog)
  priority          Priority         @default(media)
  /// "Previsão de entrega" (só a data).
  dueDate           DateTime?        @db.Date
  doneAt            DateTime?
  /// Saiu do quadro ao encerrar a sprint (vai para os relatórios).
  archivedAt        DateTime?
  /// Sprint em que a tarefa entrou no quadro / foi entregue.
  sprintId          String?
  sprint            Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  /// Quando o aviso de "tarefa atrasada" já foi enviado.
  overdueNotifiedAt DateTime?
  /// Ordem dentro da coluna do quadro.
  position          Int              @default(0)
  /// Id do evento na Google Agenda da pessoa (quando ela vincula a tarefa). Null = não está na agenda.
  calendarEventId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  checklist         ChecklistItem[]
  logs              TaskLog[]
  attachments       TaskAttachment[]

  @@index([userId, status])
  @@index([epicId])
  @@map("tasks")
}

model ChecklistItem {
  id       String  @id @default(cuid())
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text     String
  done     Boolean @default(false)
  position Int     @default(0)

  @@index([taskId])
  @@map("checklist_items")
}

/// Histórico da tarefa ("Movida de A Fazer para Fazendo").
model TaskLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_logs")
}

/// Sprint de 14 dias. Sempre existe uma em andamento (closedAt vazio) por usuário.
model Sprint {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  number             Int
  /// Nome dado pela pessoa. Vazio = "Sprint N".
  name               String    @default("")
  /// Objetivo da sprint (opcional).
  description        String    @default("")
  /// Duração em dias: 7, 14 (padrão) ou 30; 0 = indeterminada (sem prazo).
  length             Int       @default(14)
  /// Quando a pessoa apertou "Iniciar sprint". Null = em planejamento (ainda não começou).
  startAt            DateTime?
  /// Fim previsto (startAt + duração − 1 dia). Null quando não começou ou é indeterminada (sem prazo).
  plannedEnd         DateTime?
  /// Já mostrou o aviso "concluir sem sprint não rende XP" neste intervalo entre sprints.
  offSprintWarned    Boolean   @default(false)
  /// Quando avisou que o prazo venceu (uma vez por sprint).
  deadlineNotifiedAt DateTime?
  closedAt           DateTime?
  /// Preenchidos ao encerrar: "prontas/total".
  doneCount          Int?
  totalCount         Int?
  tasks              Task[]

  @@unique([userId, number])
  @@map("sprints")
}

// ---------- XP e atividade ----------

/// Motivo de cada lançamento no extrato de XP (regras provisórias em packages/shared/src/xp.ts).
enum XpReason {
  task
  check
  epic
  iniciativa
  sprint
  roda
  sonho
  post
  story
  comentario
  trilha_download
  trilha_compra
  primeiros_passos
  rede_social
}

/// Motivos do extrato de gemas.
enum GemReason {
  /// Prêmio de "Concluir minha jornada".
  jornada
  /// Sprint encerrada com todas as tarefas prontas.
  sprint
  /// Acesso do dia (ofensiva da semana).
  ofensiva
  /// Compra de trilha (negativo).
  trilha_compra
  /// Liberar a rede social antes dos 7 dias da Jornada (negativo).
  rede_social
  /// Responder uma pesquisa rápida (decisão do dono de 07/11/2026).
  pesquisa
}

/// Extrato de gemas: cada ganho (+) e gasto (-). O saldo fica copiado em User.gems.
model GemEvent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    GemReason
  refId     String?
  createdAt DateTime  @default(now())

  @@index([userId, reason, refId])
  @@map("gem_events")
}

/// Dias em que a pessoa abriu o app (no fuso dela), para a ofensiva e os acessos do mês.
model UserLoginDay {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "AAAA-MM-DD" no fuso da pessoa.
  day       String
  createdAt DateTime @default(now())

  @@id([userId, day])
  @@map("user_login_days")
}

/// Extrato de XP: cada ganho (+) e estorno (-). O total fica copiado em User.xpTotal.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    XpReason
  /// O que gerou o lançamento (tarefa, épico, sprint, dia do post…).
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, reason, refId])
  @@map("xp_events")
}

/// "Atividade recente" do perfil.
model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  icon      String
  text      String
  /// Tela para onde o item leva (ex.: /board).
  link      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("activity_events")
}

// ---------- Arquivos (storage S3) ----------

/// Para que o arquivo serve (define o limite de tamanho e a pasta no storage).
enum FilePurpose {
  avatar
  dream
  task
  post
  story
  group
  trilha
}

enum FileStatus {
  /// URL de envio criada, mas o navegador ainda não confirmou o envio.
  pending
  ready
}

/// Arquivo guardado no storage. O banco guarda só a referência (key); o arquivo vai direto do navegador para o storage.
model File {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Caminho no bucket: users/{userId}/{purpose}/{id}.{ext}
  key        String          @unique
  /// Nome original (ex.: foto.jpg).
  name       String
  mime       String
  size       Int
  purpose    FilePurpose
  status     FileStatus      @default(pending)
  createdAt  DateTime        @default(now())
  attachment TaskAttachment?
  postMedia  PostMedia?
  story      Story?

  @@index([userId, status])
  @@map("files")
}

/// Imagem anexada a uma tarefa.
model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileId    String   @unique
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_attachments")
}

// ---------- Exercícios de reflexão ----------

/// Nota atual (0 a 10) de cada área da Roda da Vida.
model RodaScore {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  area      Area
  score     Int
  updatedAt DateTime @updatedAt

  @@id([userId, area])
  @@map("roda_scores")
}

/// "Registrar avaliação de hoje": foto das 10 notas num dia (a evolução aparece nos relatórios).
model RodaSnapshot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// { "lazer": 6, "amor": 7, … }
  scores    Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("roda_snapshots")
}

/// Item da Pirâmide de Maslow marcado como atendido. Os itens em si ficam em packages/shared/src/maslow.ts.
model MaslowCheck {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ex.: "fis-0" (nível + posição do item).
  itemKey   String
  checkedAt DateTime @default(now())

  @@id([userId, itemKey])
  @@map("maslow_checks")
}

/// Reflexão escrita em um nível da pirâmide.
model MaslowNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// aut, est, soc, seg ou fis.
  level     String
  text      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("maslow_notes")
}

/// Necrológio: o texto (HTML já limpo pelo servidor). Sem seções nesta versão.
model Necrologio {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  html      String   @default("")
  updatedAt DateTime @updatedAt

  @@map("necrologios")
}

/// Sonho do Quadro de visualização (até 10 abertos). "Realizei" marca doneAt.
model Dream {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  area        Area
  imageFileId String?   @unique
  doneAt      DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("dreams")
}

// ---------- Notificações ----------

enum NotificationType {
  amizade_pedido
  amizade_aceita
  curtida
  curtida_story
  comentario
  /// Antigo: um aviso por tarefa (substituído pelo resumo diário tarefas_atrasadas).
  tarefa_atrasada
  /// Resumo diário das tarefas atrasadas.
  tarefas_atrasadas
  /// Épico com todas as tarefas prontas, não encerrado e sem tarefa nova há 3 dias.
  epico_sem_proximo
  /// Épico criado há 3 dias ou mais e ainda sem nenhuma tarefa.
  epico_vazio
  /// Dica: área da vida sem tarefa criada nem concluída há 30 dias.
  area_parada
  /// Dica: a pessoa não abre o app há 3 (e depois 7) dias.
  volte_ao_app
  /// Dica: um grupo público ligado às áreas da pessoa.
  grupo_sugerido
  /// Dica: "Aconteceu algo bom que não estava planejado?"
  algo_bom
  /// Jornada parada há 2 dias ou mais (o único aviso automático durante a Jornada).
  jornada_parada
  /// "Lembra disso?": uma conquista de pelo menos 30 dias atrás.
  lembranca
  /// Novidades de uma versão do app (publicadas pelo admin).
  novidade
  /// Pesquisa rápida (nota de 1 a 5).
  pesquisa
  sprint_iniciada
  sprint_prazo
  trilha_baixada
  trilha_aprovada
  trilha_recusada
  trilha_pendente
  grupo_entrada
  grupo_trilha
  grupo_topico
  grupo_resposta
  grupo_trilha_sugerida
  grupo_gestor
  grupo_pedido
  grupo_convite
  grupo_aprovado
  grupo_recusado
}

/// Notificação do sino (e, se ativado, também enviada ao celular).
model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String           @default("")
  /// Tela para onde a notificação leva.
  link        String
  /// Quem causou (curtiu, comentou…), se houver.
  actorId     String?
  actor       User?            @relation("NotificationsCaused", fields: [actorId], references: [id], onDelete: Cascade)
  /// O que gerou (tarefa, post…), para agrupar e evitar repetidas.
  refId       String?
  /// Foto mostrada no aviso ("Lembra disso?"). Só o id; se a foto for apagada, o aviso fica sem ela.
  imageFileId String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Categoria do aviso (o que a pessoa pode desligar). O mapa tipo → categoria fica em packages/shared/src/notifications.ts.
enum NotificationCategory {
  atividade
  alertas
  dicas
  lembrancas
  novidades
  pesquisas
}

/// Quantos avisos automáticos por dia e por semana (valores em packages/shared/src/notifications.ts).
enum NotificationVolume {
  pouco
  normal
  mais
}

/// Preferências de notificação. Sem linha = padrão (Normal, silêncio das 22h às 8h, tudo ligado).
model NotificationPrefs {
  userId      String                 @id
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  volume      NotificationVolume     @default(normal)
  /// Horário de silêncio (hora local, 0 a 23): nada vai para o celular de quietStart até quietEnd.
  quietStart  Int                    @default(22)
  quietEnd    Int                    @default(8)
  /// Categorias desligadas no sino (também não vão para o celular).
  offBell     NotificationCategory[] @default([])
  /// Categorias que não vão para o celular.
  offPush     NotificationCategory[] @default([])
  /// Quando a pessoa respondeu "Agora não" ao convite para ligar as notificações no celular.
  pushAskedAt DateTime?
  updatedAt   DateTime               @updatedAt

  @@map("notification_prefs")
}

/// Novidades de uma versão do app. O admin escreve e publica; ao publicar, todo mundo
/// fora da Jornada recebe a notificação, que abre a tela da novidade (decisão do dono de 07/11/2026).
model Release {
  id          String    @id @default(cuid())
  /// Ex.: "1.4".
  version     String
  title       String
  /// Texto simples: parágrafos separados por linha em branco; linhas com "- " viram lista.
  body        String
  createdById String?
  createdBy   User?     @relation("ReleasesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  /// Null = rascunho.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("releases")
}

/// Pesquisa rápida: uma pergunta com nota de 1 a 5, respondida no sino. Responder rende círculos.
model Survey {
  id          String           @id @default(cuid())
  question    String
  createdById String?
  createdBy   User?            @relation("SurveysCreated", fields: [createdById], references: [id], onDelete: SetNull)
  /// Null = rascunho. Ao publicar, sai para quem está fora da Jornada e não recebeu pesquisa nos últimos 30 dias.
  publishedAt DateTime?
  /// Encerrada: não aceita mais respostas.
  closedAt    DateTime?
  createdAt   DateTime         @default(now())
  responses   SurveyResponse[]

  @@map("surveys")
}

/// Resposta de uma pessoa a uma pesquisa (uma por pessoa).
model SurveyResponse {
  id        String   @id @default(cuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Nota de 1 a 5.
  score     Int
  /// Comentário opcional.
  comment   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([surveyId, userId])
  @@map("survey_responses")
}

/// Registro dos avisos automáticos já mandados: não repetir (mesma chave) e contar os limites.
/// Não some quando a pessoa limpa o sino. Apagado depois de 1 ano.
model NotificationLog {
  id       String               @id @default(cuid())
  userId   String
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     NotificationType
  category NotificationCategory
  /// Identifica o aviso (ex.: "tarefas_atrasadas:2026-11-07"). A mesma chave não sai duas vezes.
  key      String
  sentAt   DateTime             @default(now())

  @@unique([userId, key])
  @@index([userId, sentAt])
  @@map("notification_log")
}

/// Aparelho que aceitou receber notificações no celular (Web Push).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// ---------- Loja de trilhas ----------

/// Toda publicação passa por "pendente" até ser aprovada ou recusada: na loja, por um administrador
/// do app; num grupo, por um gestor do grupo (o que o gestor publica já entra aprovado).
enum TrilhaStatus {
  pendente
  aprovada
  recusada
  despublicada
}

/// Trilha: cópia congelada de um épico (com as tarefas) para importar no backlog.
/// Sem grupo = loja (qualquer pessoa baixa); com grupo = só os membros do grupo veem e baixam.
model Trilha {
  id              String              @id @default(cuid())
  /// Id da primeira versão. Versões novas da mesma trilha compartilham o rootId.
  rootId          String
  /// Versão aprovada que esta substitui quando for aprovada.
  replacesId      String?
  /// Nulo = trilha oficial do Circle of Life. No grupo: quem criou ou sugeriu.
  authorId        String?
  author          User?               @relation("TrilhasAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  /// Grupo dono da trilha (nulo = loja).
  groupId         String?
  group           Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Épico de onde a trilha foi publicada.
  sourceEpicId    String?
  /// Trilha da loja de onde esta cópia do grupo veio.
  copiedFromId    String?
  title           String
  description     String
  category        String
  /// Área principal (capa e categoria). É sempre a primeira de "areas".
  area            Area
  /// Todas as áreas do épico publicado (para aparecer em todas na loja).
  areas           Area[]              @default([])
  /// Capa: imagem enviada, ou ilustração (art + cor) com texto opcional.
  /// Não é única: a cópia do grupo usa a mesma capa da trilha da loja.
  coverFileId     String?
  art             String              @default("lake")
  color           String              @default("#5e873c")
  coverText       String?
  /// 0 = grátis. Trilhas de grupo são sempre grátis.
  /// Preço em gemas (0 = grátis).
  priceGems       Int                 @default(0)
  status          TrilhaStatus        @default(pendente)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  /// Número de downloads mostrado antes dos downloads reais (trilhas oficiais do seed).
  baseDownloads   Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tasks           TrilhaTask[]
  favorites       TrilhaFavorite[]
  acquisitions    TrilhaAcquisition[]

  @@index([status])
  @@index([rootId])
  @@index([groupId])
  @@map("trilhas")
}

model TrilhaTask {
  id          String @id @default(cuid())
  trilhaId    String
  trilha      Trilha @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  title       String
  /// Vai para a descrição da tarefa ao importar.
  description String @default("")
  /// Áreas próprias da tarefa (vazio = as do épico).
  areas       Area[] @default([])
  position    Int

  @@map("trilha_tasks")
}

model TrilhaFavorite {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trilhaId String
  trilha   Trilha @relation(fields: [trilhaId], references: [id], onDelete: Cascade)

  @@id([userId, trilhaId])
  @@map("trilha_favorites")
}

/// Quem já adquiriu (baixou ou comprou) a trilha. Dá direito a importar de novo sem pagar.
model TrilhaAcquisition {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trilhaId  String
  trilha    Trilha   @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  rootId    String
  gemsPaid  Int      @default(0)
  createdAt DateTime @default(now())

  @@id([userId, trilhaId])
  @@index([rootId])
  @@map("trilha_acquisitions")
}

// ---------- Amigos e grupos ----------

enum FriendshipStatus {
  pending
  accepted
}

/// Amizade: pedido de requester para addressee; vira "accepted" quando aceito.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

/// Bloqueio entre pessoas (completo e nos dois sentidos quando existe em qualquer direção):
/// somem uma para a outra no feed, stories, busca e não podem virar amigas.
model Block {
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksGot", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

/// admin = Gestor do grupo (aprova trilhas, modera o fórum). O criador escolhe os gestores.
enum GroupRole {
  admin
  member
}

/// Grupo criado por um usuário: pessoas interessadas num assunto e trilhas prontas.
model Group {
  id          String         @id @default(cuid())
  name        String
  description String
  area        Area
  icon        String         @default("users")
  art         String         @default("lake")
  coverFileId String?        @unique
  /// Privado: só entra quem for aprovado por um gestor ou aceitar um convite (decisão do dono de 05/11/2026).
  private     Boolean        @default(false)
  createdById String?
  createdAt   DateTime       @default(now())
  members     GroupMember[]
  requests    GroupRequest[]
  trilhas     Trilha[]
  posts       PostGroup[]
  topics      GroupTopic[]
  bans        GroupBan[]

  @@map("groups")
}

/// Pessoas banidas de um grupo: não conseguem entrar de novo até um gestor desbanir.
model GroupBan {
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_bans")
}

/// Pedido para entrar ("pedido", feito pela pessoa) ou convite ("convite", feito por um gestor).
/// Só existe enquanto está pendente: aprovar, aceitar, recusar ou cancelar apaga o registro.
enum GroupRequestKind {
  pedido
  convite
}

model GroupRequest {
  groupId     String
  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Quem vai entrar no grupo.
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        GroupRequestKind
  /// Gestor que convidou (só nos convites).
  invitedById String?
  createdAt   DateTime         @default(now())

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_requests")
}

model GroupMember {
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(member)
  joinedAt DateTime  @default(now())

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// ---------- Feed ----------

/// Post do feed. Quem vê: publico = todos; amigos = amigos do autor; privado = só o autor.
/// Post de grupo: só os membros do grupo.
model Post {
  id         String      @id @default(cuid())
  authorId   String
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Conquista (opcional), mostrada em destaque com o ✓.
  title      String      @default("")
  text       String
  /// Até 3 áreas da vida.
  areas      Area[]      @default([])
  /// Quem vê: o que a visibilidade libera + os membros dos grupos escolhidos (sem limite de grupos).
  visibility Visibility
  tags       String[]
  /// O que originou o post ao compartilhar uma conclusão (task, epic, initiative, sprint, sonho).
  refType    String?
  refId      String?
  /// "+N XP" mostrado no post, calculado pela API a partir do extrato de XP do que originou o post.
  xpShown    Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  media      PostMedia[]
  likes      PostLike[]
  saves      PostSave[]
  comments   Comment[]
  groups     PostGroup[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@map("posts")
}

/// Grupos em que o post foi publicado.
model PostGroup {
  postId  String
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([postId, groupId])
  @@index([groupId])
  @@map("post_groups")
}

/// Imagens do post (até 8), na ordem escolhida.
model PostMedia {
  id       String @id @default(cuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  fileId   String @unique
  file     File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  position Int
  /// Vídeo: trecho exibido (início e fim, em segundos). O arquivo vai inteiro; só esse trecho aparece.
  clipStart Float?
  clipEnd   Float?

  @@index([postId])
  @@map("post_media")
}

model PostLike {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@map("post_likes")
}

model PostSave {
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@map("post_saves")
}

model Comment {
  id        String            @id @default(cuid())
  postId    String
  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime          @default(now())
  reactions CommentReaction[]

  @@index([postId, createdAt])
  @@map("comments")
}

/// Reações: curtir, não curtir ou coração (decisão do dono de 06/11/2026). Uma por pessoa.
enum ReactionKind {
  like
  dislike
  heart
}

model CommentReaction {
  commentId String
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ReactionKind
  createdAt DateTime     @default(now())

  @@id([commentId, userId])
  @@index([commentId])
  @@map("comment_reactions")
}

// ---------- Stories ----------

/// Story: foto que some em 24 horas, com 1 a 3 áreas (os ícones viram marca d'água).
/// Quem vê segue a mesma regra dos posts fora de grupo.
model Story {
  id         String      @id @default(cuid())
  authorId   String
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  fileId     String      @unique
  file       File        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  areas      Area[]
  /// Legenda curta (até 150 caracteres).
  caption    String      @default("")
  /// Vídeo: trecho exibido (início e fim, em segundos), no máximo MEDIA_RULES.story.video.maxSeconds.
  clipStart  Float?
  clipEnd    Float?
  visibility Visibility
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
  likes      StoryLike[]
  views      StoryView[]

  @@index([expiresAt])
  @@index([authorId, createdAt])
  @@map("stories")
}

/// Reação a um story (curtir, não curtir ou coração). Uma por pessoa.
model StoryLike {
  storyId   String
  story     Story        @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ReactionKind @default(like)
  createdAt DateTime     @default(now())

  @@id([storyId, userId])
  @@map("story_likes")
}

/// "Visto por": só o autor vê a lista.
model StoryView {
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@id([storyId, userId])
  @@map("story_views")
}

// ---------- Análise inteligente ----------

/// "anthropic" fica só para os relatórios antigos; hoje a IA de verdade é o agente do Agents for Life (afl).
enum AiMode {
  mock
  anthropic
  afl
}

/// Relatório do "Me analise": cruza os exercícios escolhidos com o backlog.
model AnalysisReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        AiMode
  /// Fontes que a pessoa escolheu (necrologio, roda, maslow, quadro, tarefas).
  sources     String[]
  geral       Int
  /// Retrato da pessoa (nos relatórios antigos, a "visão geral").
  visao       String
  /// Só nos relatórios antigos: [{ area, pct, texto }]
  areas       Json
  /// Só nos relatórios antigos: [{ icon, titulo, texto }]
  insights    Json
  /// Formato novo: { padroes, gaps, manter, ajustar, abandonar, proximos7dias, limitantes, pergunta, cuidado }. Vazio nos antigos.
  details     Json?
  /// [{ iniciativa: { titulo, descricao, porque, areas }, epicos: [{ titulo, areas, tarefas: [{ titulo, descricao }] }] }]
  /// (nos antigos: épico com "area" e tarefas só com o título)
  suggestions Json
  /// Índices das sugestões já importadas para o backlog.
  imported    Int[]    @default([])
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("analysis_reports")
}

// ---------- Fórum dos grupos ----------

/// Tópico do fórum de um grupo. Só os membros leem e escrevem.
model GroupTopic {
  id             String       @id @default(cuid())
  groupId        String
  group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title          String
  text           String       @default("")
  /// Última resposta (ou a criação): a lista mostra primeiro os tópicos mais movimentados.
  lastActivityAt DateTime     @default(now())
  createdAt      DateTime     @default(now())
  replies        GroupReply[]

  @@index([groupId, lastActivityAt])
  @@map("group_topics")
}

model GroupReply {
  id        String     @id @default(cuid())
  topicId   String
  topic     GroupTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime   @default(now())

  @@index([topicId, createdAt])
  @@map("group_replies")
}

enum EmailCodePurpose {
  /// Confirmar o e-mail ao criar conta com senha.
  cadastro
  /// "Esqueci minha senha".
  senha
}

/// Código de 6 números enviado por e-mail. Vale 15 minutos e 5 tentativas.
model EmailCode {
  id        String           @id @default(cuid())
  email     String
  purpose   EmailCodePurpose
  /// Resumo (sha256) do código.
  codeHash  String
  /// No cadastro: nome, resumo da senha e aceite dos termos, até o e-mail ser confirmado.
  data      Json?
  attempts  Int              @default(0)
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([email, purpose])
  @@map("email_codes")
}

/// Contador de tentativas para o limite de força bruta (login, envio de códigos).
/// Guardado no banco porque, na Vercel, a API não mantém memória entre pedidos.
/// Janela fixa: quando `windowStart` passa da janela, a contagem recomeça.
model RateLimit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@map("rate_limits")
}
